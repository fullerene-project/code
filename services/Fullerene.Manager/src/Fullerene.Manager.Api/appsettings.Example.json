{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ProjectSettings": {
    "LicenseTextUrl": "https://www.gnu.org/licenses/agpl-3.0.txt",
    "LicenseHtmlUrl": "https://www.gnu.org/licenses/agpl-3.0.html",
    "SourceCodeUrl": "https://github.com/fullerene-project/code"
  },

  "BuildStrategySettings": {
    "BuildStrategy": "OnSubscription",
    "BuildLatestFromChannels": {
      "Stable": 3,
      "Beta": 2,
      "Alpha": 1
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=fullerene;Username=fullerene;Password=YOUR_SECURE_DB_PASSWORD"
  },

  "RabbitMqConnectionSettings": {
    "Host": "rabbitmq",
    "Port": "5672",
    "User": "admin",
    "Password": "YOUR_SECURE_RABBITMQ_PASSWORD"
  },
  "RabbitMqTaskQueueMappingSettings": {
    "QueueNameByTaskName": {
      "BuildTask": "build_tasks",
      "SigningTask": "signing_tasks"
    }
  },
  "RabbitMqEventQueueSubscriptionSettings": {
    "QueueName": "fullerene_manager_events",
    "ConcurrencyLimit": 2
  },

  "S3StorageSettings": {
    "InternalUrl": "http://garage:3900",
    "PublicUrl": "http://localhost:3900",
    "AccessKey": "YOUR_SECURE_S3_ACCESS_KEY",
    "SecretKey": "YOUR_SECURE_S3_SECRET_KEY",
    "Region": "garage"
  },
  "UnsignedApkS3BucketSettings": {
    "BucketName": "unsigned-artifacts"
  },
  "SignedApkS3BucketSettings": {
    "BucketName": "signed-artifacts"
  }
}
