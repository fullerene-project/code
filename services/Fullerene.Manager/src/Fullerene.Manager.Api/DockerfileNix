FROM docker.io/nixos/nix:latest AS builder
WORKDIR /src

ENV NIX_CONFIG="extra-experimental-features = nix-command flakes"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV NUGET_PACKAGES=/root/.nuget/packages

COPY services/Fullerene.Manager/flake.nix services/Fullerene.Manager/flake.lock /nix-env/
RUN nix develop /nix-env#manager --command true

COPY ["shared/Fullerene.Shared.Contracts/Fullerene.Shared.Contracts.csproj", "shared/Fullerene.Shared.Contracts/"]
COPY ["shared/Fullerene.Shared.Hosting/Fullerene.Shared.Hosting.csproj", "shared/Fullerene.Shared.Hosting/"]
COPY ["shared/Fullerene.Shared.Infrastructure/Fullerene.Shared.Infrastructure.csproj", "shared/Fullerene.Shared.Infrastructure/"]
COPY ["shared/Fullerene.Shared.Common/Fullerene.Shared.Common.csproj", "shared/Fullerene.Shared.Common/"]
COPY ["shared/Fullerene.Shared.Domain/Fullerene.Shared.Domain.csproj", "shared/Fullerene.Shared.Domain/"]

COPY ["services/Fullerene.Manager/Fullerene.Manager.slnx", "services/Fullerene.Manager/"]
COPY ["services/Fullerene.Manager/src/Fullerene.Manager.Api/Fullerene.Manager.Api.csproj", "services/Fullerene.Manager/src/Fullerene.Manager.Api/"]
COPY ["services/Fullerene.Manager/src/Fullerene.Manager.Application/Fullerene.Manager.Application.csproj", "services/Fullerene.Manager/src/Fullerene.Manager.Application/"]
COPY ["services/Fullerene.Manager/src/Fullerene.Manager.Infrastructure/Fullerene.Manager.Infrastructure.csproj", "services/Fullerene.Manager/src/Fullerene.Manager.Infrastructure/"]
COPY ["services/Fullerene.Manager/src/Fullerene.Manager.Domain/Fullerene.Manager.Domain.csproj", "services/Fullerene.Manager/src/Fullerene.Manager.Domain/"]

RUN nix develop /nix-env#manager --command dotnet restore services/Fullerene.Manager/Fullerene.Manager.slnx

COPY . .

RUN nix develop /nix-env#manager --offline --command dotnet publish services/Fullerene.Manager/src/Fullerene.Manager.Api/Fullerene.Manager.Api.csproj -c Release -o /out --no-restore

FROM docker.io/nixos/nix:latest
WORKDIR /app

ENV NIX_CONFIG="extra-experimental-features = nix-command flakes"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

COPY services/Fullerene.Manager/flake.nix services/Fullerene.Manager/flake.lock /nix-env/
RUN nix develop /nix-env#manager --command true

COPY --from=builder /out .

EXPOSE 8080

ENTRYPOINT ["nix", "develop", "/nix-env#manager", "--command", "dotnet", "Fullerene.Manager.Api.dll"]