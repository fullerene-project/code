{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "SignerIdentitySettings": {
    "CommonName": "Fullerene Farm",
    "Organization": "Fullerene Project"
  },
  "SigningSettings": {
    "MasterSeedBase64": "YOUR_HYPER_SECURE_BASE64_SECRET"
  },
  "TempSecureDirectorySettings": {
    "Path": "/path/to/temp/secrets/dir"
  },
  
  "RabbitMqSigningTaskSubscriptionSettings": {
    "QueueName": "signing_tasks",
    "ConcurrencyLimit": 2
  },
  "RabbitMqConnectionSettings": {
    "Host": "rabbitmq",
    "Port": "5672",
    "User": "admin",
    "Password": "YOUR_SECURE_RABBITMQ_PASSWORD"
  },
  
  "S3StorageSettings": {
    "InternalUrl": "http://garage:3900",
    "AccessKey": "YOUR_SECURE_S3_ACCESS_KEY",
    "SecretKey": "YOUR_SECURE_S3_SECRET_KEY",
    "Region": "garage"
  },
  "UnsignedApkS3BucketSettings": {
    "BucketName": "unsigned-artifacts"
  },
  "SignedApkS3BucketSettings": {
    "BucketName": "signed-artifacts"
  }
}
