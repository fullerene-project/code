FROM mcr.microsoft.com/dotnet/sdk:10.0 AS builder
WORKDIR /src

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV NUGET_PACKAGES=/root/.nuget/packages

COPY ["shared/Fullerene.Shared.Contracts/Fullerene.Shared.Contracts.csproj", "shared/Fullerene.Shared.Contracts/"]
COPY ["shared/Fullerene.Shared.Hosting/Fullerene.Shared.Hosting.csproj", "shared/Fullerene.Shared.Hosting/"]
COPY ["shared/Fullerene.Shared.Infrastructure/Fullerene.Shared.Infrastructure.csproj", "shared/Fullerene.Shared.Infrastructure/"]
COPY ["shared/Fullerene.Shared.Common/Fullerene.Shared.Common.csproj", "shared/Fullerene.Shared.Common/"]
COPY ["shared/Fullerene.Shared.Domain/Fullerene.Shared.Domain.csproj", "shared/Fullerene.Shared.Domain/"]

COPY ["services/Fullerene.Worker/Fullerene.Worker.slnx", "services/Fullerene.Worker/"]
COPY ["services/Fullerene.Worker/src/Fullerene.Worker.App/Fullerene.Worker.App.csproj", "services/Fullerene.Worker/src/Fullerene.Worker.App/"]
COPY ["services/Fullerene.Worker/src/Fullerene.Worker.Application/Fullerene.Worker.Application.csproj", "services/Fullerene.Worker/src/Fullerene.Worker.Application/"]
COPY ["services/Fullerene.Worker/src/Fullerene.Worker.Infrastructure/Fullerene.Worker.Infrastructure.csproj", "services/Fullerene.Worker/src/Fullerene.Worker.Infrastructure/"]

RUN dotnet restore services/Fullerene.Worker/Fullerene.Worker.slnx

COPY . .
RUN dotnet publish services/Fullerene.Worker/src/Fullerene.Worker.App/Fullerene.Worker.App.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    podman \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/publish .

ENTRYPOINT ["dotnet", "Fullerene.Worker.App.dll"]